# Copy to .env (Next.js and docker compose both read it).

# logo.dev publishable key, used to show company logos in the experience list.
# Get one at https://www.logo.dev. It's baked in at build time, so set it
# before building; without it, rows fall back to monogram tiles.
NEXT_PUBLIC_LOGO_DEV_KEY=pk_your_publishable_key

# Port the production server listens on and docker compose exposes.
# (`npm run dev` ignores this; use `npm run dev -- -p 4000` there.)
PORT=3000
